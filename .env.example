# 複製成 .env 後修改：cp .env.example .env
# .env 含密碼與金鑰，已列入 .gitignore，不要 commit。

############################################
# 1. 密碼 / Secret（每個都用不同值）
#    產生方式：openssl rand -hex 32
#    或 PowerShell：-join ((1..32) | % { '{0:x2}' -f (Get-Random -Max 256) })
#    DB_PASSWORD 用 hex 字串，避免 @ : / % 破壞連線 URL
############################################
DB_PASSWORD=change-me-hex
FASTAPI_USERS_JWT_SECRET=change-me-hex
FASTAPI_USERS_VERIFICATION_TOKEN_SECRET=change-me-hex
FASTAPI_USERS_RESET_PASSWORD_TOKEN_SECRET=change-me-hex

############################################
# 2. 知識庫服務帳號（init_kb.py 會用它建立帳號、dataset 與 API key）
############################################
KB_SERVICE_EMAIL=kb-service@example.com
KB_SERVICE_PASSWORD=change-me-strong-password
KB_DATASET=team_kb

# init_kb.py 執行後把印出的 key 貼到這裡，再啟動 cognee-mcp
COGNEE_MCP_API_KEY=

# 同事用區網 IP 或主機名連 MCP 時要列出（:* 不可省略），例如 192.168.1.50:*,kb-host:*
MCP_ALLOWED_HOSTS=

############################################
# 3. Embedding：FastEmbed（容器內 CPU 推論，免費、免 API key）
#    多語言模型，中英文都可用，384 維
#    ⚠ 一旦寫入資料就不要換模型，換了要清空重建
############################################
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384

############################################
# 4. LLM：二選一（取消註解你要的那一組）
############################################

# --- 選項 A：本機 Ollama（完全免費、資料不出機器；需 docker compose --profile ollama）
#     LLM_ENDPOINT 不要加 /v1；LLM_API_KEY 不能留空（隨便填）
LLM_PROVIDER=ollama
LLM_MODEL=llama3.1:8b
LLM_ENDPOINT=http://ollama:11434
LLM_API_KEY=ollama
# 本機推論慢，拉長逾時、降低並行
LLM_RATE_LIMIT_ENABLED=true
LLM_RATE_LIMIT_REQUESTS=4
LLM_RATE_LIMIT_INTERVAL=60

# --- 選項 B：Google Gemini 免費額度（品質較好、速度快；資料會送到 Google）
#     Key 申請：https://aistudio.google.com/api-keys
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini/gemini-2.5-flash
# LLM_API_KEY=your-gemini-api-key
# LLM_RATE_LIMIT_ENABLED=true
# LLM_RATE_LIMIT_REQUESTS=8
# LLM_RATE_LIMIT_INTERVAL=60

############################################
# 5. 其他
############################################
# 防止新註冊帳號拿到預設密碼
# DEFAULT_USER_PASSWORD 刻意不設定
TELEMETRY_DISABLED=true
